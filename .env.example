# Copy to .env and fill in. The app connects to a PostgreSQL database (Cloud SQL or any Postgres).

# Cloud SQL PostgreSQL database host/IP
SQL_HOST="127.0.0.1"

# Database Name
SQL_DB_NAME="postgres"

# SQL credentials
SQL_USER="postgres"
SQL_PASSWORD=""

# SQL Administrator setup
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
